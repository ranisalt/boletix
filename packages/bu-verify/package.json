{
  "name": "@boletix/bu-verify",
  "version": "0.0.0",
  "description": "Verify the signature and certificate chain of Brazilian boletins de urna (TSE) with WebCrypto.",
  "keywords": [
    "boletim-de-urna",
    "eleicoes",
    "signature",
    "tse",
    "x509"
  ],
  "homepage": "https://github.com/ranisalt/boletix/tree/main/packages/bu-verify#readme",
  "bugs": "https://github.com/ranisalt/boletix/issues",
  "license": "BSD-3-Clause",
  "author": "Ranieri Althoff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranisalt/boletix.git",
    "directory": "packages/bu-verify"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./roots": {
      "types": "./dist/roots.d.ts",
      "default": "./dist/roots.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c ../../oxlint.config.js --deny-warnings src test",
    "pack:check": "publint --strict && attw --pack --profile esm-only",
    "prepack": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@boletix/bu-qr": "workspace:^",
    "@boletix/ed521": "workspace:^",
    "@peculiar/asn1-schema": "^2.11.1",
    "@peculiar/asn1-x509": "^2.11.1"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=26"
  }
}
