{
  "name": "boletix",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vite build",
    "check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint --concurrency auto --fix .",
    "lint:check": "eslint --cache --cache-location node_modules/.cache/eslint --concurrency auto .",
    "packages:build": "pnpm -r --filter './packages/*' build",
    "packages:check": "pnpm -r --filter './packages/*' check",
    "packages:lint": "pnpm -r --filter './packages/*' lint",
    "packages:test": "pnpm -r --filter './packages/*' test",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest"
  },
  "dependencies": {
    "@lucide/svelte": "^1.61.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@peculiar/asn1-schema": "^2.11.1",
    "@peculiar/asn1-x509": "^2.11.1",
    "@sentry/cloudflare": "^11.9.0",
    "@sentry/sveltekit": "^11.9.0",
    "valibot": "^1.5.0",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.29.1",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "mdsvex": "^0.12.8",
    "msw": "^3.0.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.90.0",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1"
}
