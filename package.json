{
  "name": "boletix",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vite build",
    "check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "vite dev",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint --concurrency auto --fix .",
    "lint:check": "eslint --cache --cache-location node_modules/.cache/eslint --concurrency auto .",
    "prepare": "svelte-kit sync || echo ''",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lucide/svelte": "^1.61.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@peculiar/asn1-schema": "^2.10.0",
    "@peculiar/asn1-x509": "^2.10.0",
    "@sentry/cloudflare": "^11.4.0",
    "@sentry/sveltekit": "^11.4.0",
    "valibot": "^1.5.0",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.18.2",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.4",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "oxfmt": "^0.74.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.147.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1"
}
