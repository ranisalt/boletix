{
  "name": "boletix",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "pnpm packages:build && vite build",
    "changeset": "changeset",
    "check": "pnpm packages:build && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "dev": "pnpm packages:build && vite dev",
    "format": "oxfmt -c oxfmt.config.js --write",
    "format:check": "oxfmt -c oxfmt.config.js --check",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint --concurrency auto --fix .",
    "lint:check": "eslint --cache --cache-location node_modules/.cache/eslint --concurrency auto .",
    "packages:build": "pnpm -r --filter './packages/*' build",
    "packages:check": "pnpm -r --filter './packages/*' check",
    "packages:lint": "pnpm -r --filter './packages/*' lint",
    "packages:test": "pnpm -r --filter './packages/*' test",
    "prepare": "pnpm packages:build && (svelte-kit sync || echo '')",
    "preview": "vite preview",
    "release": "pnpm packages:build && changeset publish",
    "test": "pnpm packages:build && vitest run",
    "test:unit": "vitest",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "dependencies": {
    "@boletix/bu-qr": "workspace:^",
    "@boletix/bu-verify": "workspace:^",
    "@lucide/svelte": "^1.66.0",
    "@sentry/cloudflare": "^11.10.0",
    "@sentry/sveltekit": "^11.10.0",
    "valibot": "^1.5.0",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.29.3",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "mdsvex": "^0.12.8",
    "msw": "^3.0.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "publint": "^0.3.25",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1"
}
