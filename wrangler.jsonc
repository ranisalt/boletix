{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boletix",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "observability": {
    "logs": {
      "enabled": true,
      // Sentry already records requests and traces; keep only our own console output.
      "invocation_logs": false,
      "persist": true,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boletix",
      "database_id": "56b8ad64-075c-48b8-a82b-6a5b326b5208",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ORIGINALS",
      "bucket_name": "boletix-originals",
    },
  ],
  "ratelimits": [
    {
      "name": "SUBMIT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "vars": {
    "ALLOW_TEST_FASES": "false",
  },
  "upload_source_maps": true,
}
